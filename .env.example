# Copy to .env and fill in. Add at least one key.
ANTHROPIC_API_KEY=sk-ant-...   # used for the cheap "is this question for me?" check (Haiku)
OPENAI_API_KEY=sk-...          # used for answers, notes and the knowledge base

# Who you are (names people call you; aliases catch mis-transcriptions)
# MY_NAME=Milan Sunar
# MY_ALIASES=Milan,Mellem,Milon,Meelan

# Models (provider is picked from the name: claude-* -> Anthropic, else OpenAI)
# TRIAGE_MODEL=claude-haiku-5-5   # default when ANTHROPIC_API_KEY is set, else gpt-5.4-mini
# MAIN_MODEL=gpt-5.4-mini         # default when OPENAI_API_KEY is set, else claude-opus-5-5
# QUESTIONS_MODEL=gpt-5.4          # suggests what to ask; runs a few times per meeting
# QUESTIONS_EFFORT=medium
# CHAT_MODEL=gpt-5.5              # AI Chat tab + weekly review (default: best model for your key)
# CHAT_EFFORT=medium
# WEEKLY_DAY=4                    # weekly review day, 0=Mon … 4=Fri; "off" disables
# WEEKLY_HOUR=15
# CLAUDE_EFFORT=low
# OPENAI_REASONING=low
# MODEL_PRICES=some-model=IN/CACHED/OUT   # USD per 1M tokens; common OpenAI/Claude models are built in (config.py)

# Speech-to-text
# TRANSCRIBE_BACKEND=local        # local = mlx-whisper (free) · openai = paid API
# WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# WHISPER_LANGUAGE=en
# TRANSCRIBE_MODEL=gpt-4o-mini-transcribe   # only for TRANSCRIBE_BACKEND=openai
# PARTIAL_MODEL=mlx-community/whisper-base.en-mlx   # live draft line while people talk; off to disable
# PARTIAL_EVERY_S=0.5
# AUDIO_DEBUG=audio_debug.log   # log mic levels / speech detection every 5 s, if the transcript stalls

# When to spend tokens
# AUTO_MODE=off                   # off: AI only runs when you click · on: auto-answer, notes and questions on timers
# SENSITIVITY=normal              # low: only when named · normal · high: any question
# SUMMARY_EVERY_S=300
# QUESTIONS_EVERY_S=240           # fallback timer; also runs on "any questions?" and topic changes
# QUESTIONS_COOLDOWN_S=45
# SUMMARY_MIN_NEW_WORDS=80

# VAULT_DIR=./vault
